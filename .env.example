# Copy to `.env` and fill in (do not commit `.env`).
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# Single project for local + production: qnorggoycwbbxdlvbcvq (Company Appraisals).
# Keys: Supabase Dashboard → Project Settings → API → Project API keys → anon (public)
# If you omit these, the app falls back to this project’s URL + anon key (so Render builds work without env).

VITE_SUPABASE_URL=https://qnorggoycwbbxdlvbcvq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only (never VITE_): create demo logins for every employee email — npm run seed:demo-auth
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_DEFAULT_PASSWORD=BoomEoDemo2026!
# DEMO_ADMIN_EMAIL=bunmi.akinyemiju@peopleos.co

# Supabase CLI (npm run db:push / npm run supabase:deploy) — never VITE_
# SUPABASE_ACCESS_TOKEN=   # Dashboard → Account → Access Tokens (also: npm run setup:production-hosts -- --apply)
# SUPABASE_DB_PASSWORD=    # Dashboard → Project Settings → Database → password
#
# Render custom domains (executive.vgg.tools, vigipay.vgg.tools) — npm run setup:production-hosts -- --apply
# RENDER_API_KEY=          # Render → Account Settings → API Keys
# RENDER_SERVICE_ID=       # optional; else matched by RENDER_SERVICE_NAME (default three60appraisal)
# RENDER_SERVICE_NAME=three60appraisal
# DATABASE_URL=            # optional alternative: full postgres URL (password extracted for link)
# LOVABLE_API_KEY=         # edge functions: auth-email-hook, process-email-queue (forgot-password emails)

# --- Migration old → new (see .env fill-in block; do not commit real values) ---
# OLD_SUPABASE_PROJECT_REF=sgttsotrvemmgmujcuay
# OLD_SUPABASE_URL=https://sgttsotrvemmgmujcuay.supabase.co
# OLD_SUPABASE_DB_PASSWORD=
# OLD_SUPABASE_ANON_KEY=
# OLD_SUPABASE_SERVICE_ROLE_KEY=
# NEW_SUPABASE_PROJECT_REF=qnorggoycwbbxdlvbcvq
# NEW_SUPABASE_URL=https://qnorggoycwbbxdlvbcvq.supabase.co
# NEW_SUPABASE_DB_PASSWORD=
# NEW_SUPABASE_ANON_KEY=
# NEW_SUPABASE_SERVICE_ROLE_KEY=

# Optional: URL or site-relative path to the demo 360 spreadsheet (e.g. /data/your-file.xlsx with file in public/data/).
VITE_DEMO_APPRAISAL_XLSX_PATH=

# Optional: legacy admin demo login (disabled if either is empty). VITE_ values are still visible in the client bundle—do not use in production.
VITE_LEGACY_ADMIN_EMAIL=
VITE_LEGACY_ADMIN_PASSWORD=
VITE_LEGACY_ADMIN_NAME=

# Keep built-in app AI paths (chat/resources/insights) enabled.
# Set to false only if you intentionally want to disable AI surfaces.

